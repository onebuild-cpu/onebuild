# Environment files
.env
.env.local
.env.production

# Database backups
*.sql
*.dump

# But track schema files in /database
!database/*.sql

# Logs
logs/*
!logs/security/
logs/security/*
!logs/security/.htaccess

*.log

# Cache files
cache/
tmp/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Vendor dependencies
vendor/

# User uploads (optional - you might want to track some)
public/uploads/media/*
!public/uploads/media/.htaccess
!public/uploads/media/noimage*.webp

# Backup files
*.bak
*.backup

# Security audit files (remove after review)
public/security-audit-report.php
public/test-*.html
public/test-*.php

# Sessions & storage
storage/sessions/*
!storage/sessions/.gitkeep

storage/cache/*
!storage/cache/.gitkeep

storage/logs/*
!storage/logs/.gitkeep

storage/tmp/*
!storage/tmp/.gitkeep

dump_file.py
project_dump.md
project_dump*.md


# User uploads — never commit actual files, only .htaccess gatekeepers
public/uploads/**/*
!public/uploads/**/.htaccess